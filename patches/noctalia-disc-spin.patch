+void OsdOverlay::startGlyphSpin(Instance& inst) {
+  if (inst.glyph == nullptr) {
+    return;
+  }
+  constexpr float kSpinDurationMs = 2800.0F;
+  constexpr float kTwoPi = 6.28318530718F;
+  // animateTimer: küresel animasyon hızı/azaltma ayarlarından bağımsız çalışır.
+  inst.spinAnimId = inst.animations.animateTimer(
+      0.0F, kTwoPi, kSpinDurationMs, Easing::Linear,
+      [&inst](float v) {
+        if (inst.glyph != nullptr) {
+          inst.glyph->setRotation(v);
+        }
+      },
+      [this, &inst]() {
+        inst.spinAnimId = 0;
+        startGlyphSpin(inst);
+      },
+      inst.glyph
+  );
+}
