+std::string ActiveWindowWidget::resolveAppName(const std::string& appId) {
+  if (appId.empty()) {
+    return {};
+  }
+
+  if (const auto internal = internal_apps::metadataForAppId(appId);
+      internal.has_value() && !internal->displayName.empty()) {
+    return internal->displayName;
+  }
+
+  if (const auto entry = app_identity::findDesktopEntry(appId, desktopEntries());
+      entry.has_value() && !entry->name.empty()) {
+    return entry->name;
+  }
+
+  return {};
+}
