+void PanelManager::setHoverDismiss(bool enabled) {
+  m_hoverDismissEnabled = enabled;
+  if (!enabled) {
+    m_hoverDismissTimer.stop();
+    m_panelHovered = false;
+    m_triggerHovered = false;
+  }
+}
+
+void PanelManager::setHoverTriggerHovered(bool hovered) {
+  m_triggerHovered = hovered;
+  if (hovered) {
+    cancelHoverDismiss();
+  } else {
+    armHoverDismiss();
+  }
+}
+
+bool PanelManager::panelSurfaceContains(float sx, float sy) const {
+  if (m_surface == nullptr) {
+    return false;
+  }
+  const float w = static_cast<float>(m_surface->width());
+  const float h = static_cast<float>(m_surface->height());
+  if (w <= 0.0F || h <= 0.0F) {
+    return false;
+  }
+  return sx >= 0.0F && sy >= 0.0F && sx <= w && sy <= h;
+}
+
+void PanelManager::applyPanelEnterHover(float sx, float sy) {
+  const bool inside = panelSurfaceContains(sx, sy);
+  m_pointerInside = inside;
+  // (0,0) is what the focus grab uses for a synthetic enter, so require the
+  // coordinates to be strictly inside the panel before trusting the enter.
+  if (inside && sx > 0.0F && sy > 0.0F) {
+    m_panelHovered = true;
+    cancelHoverDismiss();
+  }
+}
+
+void PanelManager::applyPanelMotionHover(float sx, float sy) {
+  const bool inside = panelSurfaceContains(sx, sy);
+  m_pointerInside = inside;
+  m_panelHovered = inside;
+  if (inside) {
+    cancelHoverDismiss();
+  } else {
+    armHoverDismiss();
+  }
+}
+
+void PanelManager::armHoverDismiss() {
+  if (!m_hoverDismissEnabled || !isOpen() || m_closing) {
+    return;
+  }
+  // Grace period: closing is deferred so the pointer can travel between the
+  // bar trigger and the panel body without dismissing it on the way.
+  m_hoverDismissTimer.start(std::chrono::milliseconds(250), [this]() {
+    if (m_hoverDismissEnabled && isOpen() && !m_closing && !m_panelHovered && !m_triggerHovered
+        && m_attachedPopupCount == 0) {
+      closePanel();
+    }
+  });
+}
+
+void PanelManager::cancelHoverDismiss() { m_hoverDismissTimer.stop(); }
